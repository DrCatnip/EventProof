<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<ScrollPane xmlns="http://javafx.com/javafx/27" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eventproof.controller.DashboardController" fitToWidth="true" hbarPolicy="NEVER" styleClass="dashboard-scroll">
<content><VBox spacing="20" styleClass="workspace-page">
<HBox alignment="CENTER_LEFT"><VBox spacing="6"><Label text="Operations Dashboard" styleClass="page-title"/><Label text="Your event readiness, backed by current database records." styleClass="muted"/></VBox><Region HBox.hgrow="ALWAYS"/><Button text="Refresh" onAction="#refresh"><graphic><FontIcon iconLiteral="fth-refresh-cw"/></graphic></Button></HBox>
<HBox spacing="16">
<VBox spacing="10" styleClass="card,stat-card" prefWidth="240" HBox.hgrow="ALWAYS"><HBox><Label text="Total events" styleClass="muted"/><Region HBox.hgrow="ALWAYS"/><FontIcon iconLiteral="fth-calendar" styleClass="stat-icon"/></HBox><Label fx:id="eventCount" text="--" styleClass="stat-value"/><Label text="All recorded events" styleClass="footnote"/></VBox>
<VBox spacing="10" styleClass="card,stat-card" prefWidth="240" HBox.hgrow="ALWAYS"><HBox><Label text="Venues" styleClass="muted"/><Region HBox.hgrow="ALWAYS"/><FontIcon iconLiteral="fth-map-pin" styleClass="stat-icon"/></HBox><Label fx:id="venueCount" text="--" styleClass="stat-value"/><Label text="Event spaces in your database" styleClass="footnote"/></VBox>
<VBox spacing="10" styleClass="card,stat-card" prefWidth="240" HBox.hgrow="ALWAYS"><HBox><Label text="Recorded incidents" styleClass="muted"/><Region HBox.hgrow="ALWAYS"/><FontIcon iconLiteral="fth-alert-triangle" styleClass="stat-icon"/></HBox><Label fx:id="incidentCount" text="--" styleClass="stat-value"/><Label text="History used in assessments" styleClass="footnote"/></VBox>
</HBox>
<HBox alignment="CENTER_LEFT"><Label text="Upcoming event readiness" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="average" text="Awaiting database" styleClass="footnote"/></HBox>
<fx:include fx:id="assessment" source="AssessmentPane.fxml"/>
<HBox alignment="CENTER_LEFT"><Label text="Upcoming Events" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><Button fx:id="assessButton" text="View reliability" onAction="#viewSelected"><graphic><FontIcon iconLiteral="fth-activity"/></graphic></Button></HBox>
<TableView fx:id="upcoming" prefHeight="230" minHeight="180"/>
<HBox alignment="CENTER_LEFT" spacing="10"><ProgressIndicator fx:id="busy" prefWidth="18" prefHeight="18" visible="false" managed="false"/><Label fx:id="status" text="Loading database..." wrapText="true" styleClass="muted"/></HBox>
</VBox></content></ScrollPane>
